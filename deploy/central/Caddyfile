{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# Internal endpoints are not published; Prometheus scrapes central:8080 directly.
	@internal path /metrics /metrics/* /health/ready
	respond @internal 404

	# Admin/export API (static Bearer token) only from TOPAZ_ADMIN_ALLOW_IPS in .env (space-separated IPs/CIDRs);
	# unset = nobody from outside. The web interface does not use it.
	@admin_outside {
		path /api/v1/admin/* /api/v1/export/*
		not remote_ip {$TOPAZ_ADMIN_ALLOW_IPS:127.0.0.1/32}
	}
	respond @admin_outside 403

	reverse_proxy central:8080 {
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Access log as a file on the host (deploy/central/logs/caddy), read by fail2ban.
	# Caddy 2.8 sends a site's access log to one output only, so it is not in `docker compose logs`.
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}
}
