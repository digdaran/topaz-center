{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# Internal endpoints are not published; Prometheus scrapes central:8080 directly.
	@internal path /metrics /metrics/* /health/ready
	respond @internal 404

	# Admin/export API (static Bearer token) only from TOPAZ_ADMIN_ALLOW_IPS in .env (space-separated IPs/CIDRs);
	# unset = nobody from outside. The web interface does not use it.
	@admin_outside {
		path /api/v1/admin/* /api/v1/export/*
		not remote_ip {$TOPAZ_ADMIN_ALLOW_IPS:127.0.0.1/32}
	}
	respond @admin_outside 403

	reverse_proxy central:8080 {
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Access log as a file on the host (deploy/central/logs/caddy), read by fail2ban.
	# Caddy 2.8 sends a site's access log to one output only, so it is not in `docker compose logs`.
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}
}

# Public site (landing, container "site", files in ../../site). Its request form posts to /api/leads, which goes to
# central's POST /api/v1/leads; no other API is reachable from this address.
{$SITE_DOMAIN} {
	encode zstd gzip

	@lead {
		method POST
		path /api/leads
	}
	handle @lead {
		rewrite * /api/v1/leads
		reverse_proxy central:8080 {
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle /api/* {
		respond 404
	}
	handle {
		reverse_proxy site:80
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Яндекс Метрика: tag.js from mc.yandex.ru, beacons to mc.yandex.ru/ru (no Webvisor).
		Content-Security-Policy "default-src 'self'; script-src 'self' https://mc.yandex.ru https://yastatic.net; img-src 'self' data: https://mc.yandex.ru https://mc.yandex.com; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com; frame-src https://mc.yandex.ru https://mc.yandex.com; style-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	log {
		output file /var/log/caddy/site-access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}
}

# Superadmin console (CONSOLE_DOMAIN, e.g. admin.topaz.08u.ru): the same service, but superadmins sign in only here
# and nobody else can (Topaz__ConsoleHost). Only the web interface is published; optional allow-list of addresses.
{$CONSOLE_DOMAIN} {
	encode gzip

	@outside not remote_ip {$TOPAZ_CONSOLE_ALLOW_IPS}
	respond @outside 403

	@ui path /api/v1/ui/*
	handle @ui {
		reverse_proxy central:8080 {
			header_up X-Forwarded-Proto {scheme}
		}
	}
	# Agents, admin/export API, site requests, metrics and health stay on their own addresses.
	@closed path /api/* /metrics /metrics/* /health/*
	handle @closed {
		respond 404
	}
	handle {
		reverse_proxy central:8080 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Same file as the clients' address: the fail2ban jails cover the console too.
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}
}
