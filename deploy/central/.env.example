# Copy to .env and fill in. Never commit .env.
DOMAIN=topaz.example.com
ACME_EMAIL=admin@example.com

# openssl rand -base64 32
POSTGRES_PASSWORD=
# Admin/export API bearer token, >= 24 chars. openssl rand -hex 32
TOPAZ_ADMIN_TOKEN=

# First user of the web interface (superadmin), created on the first start only (then remove the password).
# Alternative: docker compose exec central dotnet Topaz.Central.dll create-user --login admin --role superadmin
# Stations need no key: a new agent sends a connection request that the superadmin approves (АЗС -> Подключение).
TOPAZ_BOOTSTRAP_OWNER_LOGIN=admin
TOPAZ_BOOTSTRAP_OWNER_PASSWORD=
# Telegram bot for alerts (optional): token from @BotFather
TOPAZ_TELEGRAM_BOT_TOKEN=

TOPAZ_RAW_RETENTION_DAYS=90
TOPAZ_STATION_SILENT_MINUTES=15
# Prebuilt image (CI publishes ghcr.io/<owner>/topaz-central:<tag>); leave empty to build locally.
CENTRAL_IMAGE=
# Daily backups kept in ./backups (each is about 1/6 of the database size)
TOPAZ_BACKUP_KEEP=3
# Server problems (disk, database, backups) from watchdog.sh to these Telegram chat ids (comma-separated),
# sent by the bot above. Disk alert threshold in percent.
TOPAZ_WATCHDOG_TELEGRAM_CHAT=
TOPAZ_WATCHDOG_DISK_PCT=85
