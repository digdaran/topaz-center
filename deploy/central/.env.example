# Copy to .env and fill in. Never commit .env.
DOMAIN=topaz.example.com
ACME_EMAIL=admin@example.com

# openssl rand -base64 32
POSTGRES_PASSWORD=
# Admin/export API bearer token, >= 24 chars. openssl rand -hex 32
TOPAZ_ADMIN_TOKEN=

# First user of the web interface (superadmin), created on the first start only (then remove the password).
# Alternative: docker compose exec central dotnet Topaz.Central.dll create-user --login admin --role superadmin
# Stations need no key: a new agent sends a connection request that the superadmin approves (АЗС -> Подключение).
TOPAZ_BOOTSTRAP_OWNER_LOGIN=admin
TOPAZ_BOOTSTRAP_OWNER_PASSWORD=
# Telegram bot for alerts (optional): token from @BotFather
TOPAZ_TELEGRAM_BOT_TOKEN=
# api.telegram.org blocked on this host? Telegram through a VPN server (Remnawave/xray subscription):
#   TOPAZ_TELEGRAM_PROXY_SUBSCRIPTION=<subscription link>
#   then: python3 telegram-proxy/make-config.py && docker compose up -d
#COMPOSE_PROFILES=telegram-proxy
#TOPAZ_TELEGRAM_PROXY=http://telegram-proxy:3128
TOPAZ_TELEGRAM_PROXY_SUBSCRIPTION=

TOPAZ_RAW_RETENTION_DAYS=90
TOPAZ_STATION_SILENT_MINUTES=15
# Prebuilt image (CI publishes ghcr.io/<owner>/topaz-central:<tag>); leave empty to build locally.
CENTRAL_IMAGE=
# Daily backups kept in ./backups (each is about 1/6 of the database size)
TOPAZ_BACKUP_KEEP=3
# Server problems (disk, database, backups) from watchdog.sh to these Telegram chat ids (comma-separated),
# sent by the bot above. Disk alert threshold in percent.
TOPAZ_WATCHDOG_TELEGRAM_CHAT=
TOPAZ_WATCHDOG_DISK_PCT=85
# Admin/export API (Bearer TOPAZ_ADMIN_TOKEN) is answered only for these addresses (space-separated IPs/CIDRs);
# empty = nobody from outside. The web interface does not need it.
TOPAZ_ADMIN_ALLOW_IPS=

# Public site (the landing in site/, container "site"). Point its DNS A record to this server first:
# Caddy gets the certificate on start. Unset = the site is not published.
#SITE_DOMAIN=azshub.ru
#SITE_WWW_DOMAIN=www.azshub.ru   # optional: redirects to SITE_DOMAIN (needs its own A record)

# Superadmin console on its own address (A record → this server). Superadmins then sign in only there and nobody else
# can; their passkeys have to be created anew at the console. Unset = one address for everybody.
#CONSOLE_DOMAIN=admin.topaz.example.com
# Optional: the console only from these addresses (space-separated IPs/CIDRs). Unset = from anywhere (password + code).
#TOPAZ_CONSOLE_ALLOW_IPS=

# Public demo (profile "demo": add it to COMPOSE_PROFILES, e.g. COMPOSE_PROFILES=demo or telegram-proxy,demo).
# A separate read-only instance on its own database with a fictional network of 3 stations (a year of history, kept
# live by demo-feeder). A record DEMO_DOMAIN → this server first.
#DEMO_DOMAIN=demo.topaz.example.com
#DEMO_POSTGRES_PASSWORD=   # openssl rand -base64 32
#DEMO_ADMIN_TOKEN=         # openssl rand -hex 32
#DEMO_LOGIN=demo           # the visitor account, shown on the demo's login screen
#DEMO_PASSWORD=demo-azs-hub
#DEMO_CPUS=2               # CPU limit of the demo's database and server
