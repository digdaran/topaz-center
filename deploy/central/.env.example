# Copy to .env and fill in. Never commit .env.
DOMAIN=topaz.example.com
ACME_EMAIL=admin@example.com

# openssl rand -base64 32
POSTGRES_PASSWORD=
# Shared install key typed into each agent once (enrollment). openssl rand -hex 16
TOPAZ_ENROLLMENT_KEY=
# Admin/export API bearer token, >= 24 chars. openssl rand -hex 32
TOPAZ_ADMIN_TOKEN=

TOPAZ_RAW_RETENTION_DAYS=90
TOPAZ_STATION_SILENT_MINUTES=15
# Prebuilt image (CI publishes ghcr.io/<owner>/topaz-central:<tag>); leave empty to build locally.
CENTRAL_IMAGE=
