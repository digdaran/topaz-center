{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Topaz": {
    "RawRetentionDays": 90,
    "StationSilentMinutes": 15,
    "MaxProcessingAttempts": 5,
    "MaxRequestBodyBytes": 67108864,
    "BatchesPerMinutePerStation": 600
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.Hosting.Lifetime": "Information" }
    }
  },
  "AllowedHosts": "*"
}
