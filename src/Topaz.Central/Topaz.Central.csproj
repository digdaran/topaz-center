    <PackageReference Include="Serilog.Sinks.Console" VersionOverride="5.0.1" />
    <PackageReference Include="System.Formats.Cbor" VersionOverride="8.0.2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\Migrations\*.sql" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Topaz.Central.Tests" />
  </ItemGroup>
</Project>
