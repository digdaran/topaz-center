<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <!-- net8.0: tests and development on Linux; net8.0-windows: the shipped agent with the setup window (WinForms). -->
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <RootNamespace>Topaz.Agent</RootNamespace>
    <AssemblyName>TopazAgent</AssemblyName>
    <OutputType>Exe</OutputType>
    <UserSecretsId>topaz-agent</UserSecretsId>
    <!-- self-contained single-file publish for Windows; see deploy/agent/README.md -->
    <RuntimeIdentifiers>win-x64;win-x86;linux-x64</RuntimeIdentifiers>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <!-- No console window on double click; console commands attach to the parent console (Setup/ConsoleAttach). -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9.75pt</ApplicationDefaultFont>
    <!-- WinForms runtime packs exist for Windows only -->
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>agent.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Topaz.Contracts\Topaz.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Update="datasets.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- Also inside the exe: the one-file setup writes them next to the installed agent. -->
    <EmbeddedResource Include="appsettings.json" LogicalName="defaults.appsettings.json" />
    <EmbeddedResource Include="datasets.json" LogicalName="defaults.datasets.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0-windows'">
    <Compile Remove="Setup/Ui/**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Topaz.Agent.Tests" />
  </ItemGroup>
</Project>
